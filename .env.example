# Copy to .env; use a private PostgreSQL database.
DATABASE_URL="postgresql://dealsphere:dealsphere_local@127.0.0.1:5432/dealsphere?schema=public"
BETTER_AUTH_URL="http://localhost:3000"
# Replace with at least 32 cryptographically random characters.
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"
# Default adapters require no external keys and never move money.
PAYMENT_MODE="demo"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MERCHANT_ID=""
PAYPAL_MERCHANT_EMAIL=""
PAYPAL_SELLER_USER_ID="demo-seller"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-4-6"
